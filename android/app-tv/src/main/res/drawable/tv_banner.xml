<!-- Launcher banner for Android TV and Fire TV (320 x 180). A plain placeholder until the
     brand has an image mark: the app background with an accent bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size
          android:width="320dp"
          android:height="180dp" />
      <solid android:color="@color/sn_bg" />
    </shape>
  </item>
  <item
      android:width="120dp"
      android:height="8dp"
      android:gravity="center">
    <shape android:shape="rectangle">
      <solid android:color="@color/sn_accent" />
      <corners android:radius="4dp" />
    </shape>
  </item>
</layer-list>
