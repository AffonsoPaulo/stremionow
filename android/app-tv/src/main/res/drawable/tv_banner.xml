<!-- Launcher banner for Android TV and Fire TV (320 x 180): the app's mark (sn_mark.xml) on
     the app background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size
          android:width="320dp"
          android:height="180dp" />
      <solid android:color="@color/sn_bg" />
    </shape>
  </item>
  <item
      android:width="160dp"
      android:height="160dp"
      android:drawable="@drawable/sn_mark"
      android:gravity="center" />
</layer-list>
