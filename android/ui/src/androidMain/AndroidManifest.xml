<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Android 17 blocks connections to devices on the local network unless the app holds this
    permission. It is requested only when the user installs an addon hosted on their network,
    or pairs with or serves other devices.
  -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <!-- Tells Wi-Fi from mobile data for the "Only on Wi-Fi" torrent preference. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!--
    Lets mDNS through Wi-Fi while looking for, or announcing, a device that serves torrents
    to the others (Settings > Other devices). Held only during discovery and while serving.
  -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
</manifest>
