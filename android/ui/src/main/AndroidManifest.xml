<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Android 17 blocks connections to devices on the local network unless the app holds this
    permission. It is requested only when the user installs an addon hosted on their network.
  -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
</manifest>
