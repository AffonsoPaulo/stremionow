<resources>
  <!-- Window theme shared by the phone and TV apps. Compose draws everything else; this only
       keeps the window dark while the first frame loads. Colors come from the design tokens. -->
  <style name="Theme.StremioNow" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/sn_bg</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
</resources>
